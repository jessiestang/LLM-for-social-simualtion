{
  "model_class": "SegregationModel",
  "framework": "Mesa",
  "time_model": "Discrete",
  "scheduler": "RandomActivation",

  "parameters": {
    "num_agents": "int",
    "width": "int",
    "height": "int"
  },

  "agent_types": {
    "AgentRacialType1": {
      "attributes": {
        "homogeneity_preference": "float [0,1]",
        "decision_signal": "float"
      },
      "methods": ["decide_movement", "move"],
      "decision_rule": "IF decision_signal < homogeneity_preference THEN move"
    },
    "AgentRacialType2": {
      "attributes": {
        "homogeneity_preference": "float [0,1]",
        "decision_signal": "float"
      },
      "methods": ["decide_movement", "move"],
      "decision_rule": "IF decision_signal < homogeneity_preference THEN move"
    }
  },

  "environment": {
    "space": "MultiGrid",
    "neighborhood": "Moore",
    "torus": true,
    "vacancy": "implicit empty cells"
  },

  "decision_variables": {
    "racial_composition_neighbor": "float [0,1]",
    "vacant_spot_availability": "float [0,1]"
  },

  "decision_formula": {
    "expression": "decision_signal = 0.8 * racial_composition_neighbor + 0.2 * vacant_spot_availability",
    "parameters": {
      "racial_weight": 0.8,
      "vacancy_weight": 0.2
    }
  },

  "outputs": {
    "unhappy_agents_count": "List[int]",
    "agent_decision_signal": "float"
  },

  "data_collection": {
    "agent_reporters": {
      "Unhappy": "decision_signal"
    }
  }
}